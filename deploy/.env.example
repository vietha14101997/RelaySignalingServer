# Relay Server Configuration
RELAY_PORT=8443
DATABASE_URL=postgres://relay:YOUR_DB_PASSWORD@localhost:5432/relay?sslmode=disable
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
TLS_CERT_FILE=/etc/letsencrypt/live/relay.remoteplay.app/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/relay.remoteplay.app/privkey.pem

# TURN/STUN (must match coturn static-auth-secret)
TURN_SECRET=MUST_MATCH_COTURN_STATIC_AUTH_SECRET
TURN_DOMAIN=relay.remoteplay.app
