# ── RemoteScreen Relay — Docker deployment ──
# 1) cp .env.example .env
# 2) fill the secrets below (commands shown)
# 3) ./add-domain.sh <domain> [acme-email]   ← sets RELAY_DOMAIN/TURN_DOMAIN/EXTERNAL_IP + brings the stack up
#
# NEVER commit the real .env.

# Domain + public IP — leave blank; add-domain.sh fills these in.
RELAY_DOMAIN=
TURN_DOMAIN=
EXTERNAL_IP=
ACME_EMAIL=

# PROXIED mode only (VPS already has a reverse proxy on 80/443): the host
# loopback port the bundled relay is published on for your proxy to reach.
# Ignored in standalone mode. Change if 8443 is already taken on the host.
RELAY_HOST_PORT=8443

# ── Relay auth ──
# openssl rand -hex 32
JWT_SECRET=
# optional; enables GET /diagnose and GET /telemetry/stats.  openssl rand -hex 16
RELAY_ADMIN_TOKEN=
# WS-drop grace (seconds) + max concurrently-stale sessions (see relay config.go)
SESSION_GRACE=30
MAX_STALE_SESSIONS=100

# ── Postgres ──
POSTGRES_USER=relay
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=relay

# ── TURN (coturn) ──
# MUST be the shared secret; the relay signs time-limited creds with it and
# coturn validates them (use-auth-secret). openssl rand -hex 32
TURN_SECRET=
